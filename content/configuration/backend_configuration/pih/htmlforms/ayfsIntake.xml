<htmlform formUuid="c225bf8c-40ff-4911-83e0-44c876bc3865"
          formName="AYFS Initial"
          formEncounterType="1f3375af-fd9e-42a9-954e-99533ee15de9"
          formVersion="1.0">

    <postSubmissionAction class="org.openmrs.module.pihcore.htmlformentry.action.ApplyDispositionAction"/>
    <postSubmissionAction class="org.openmrs.module.pihcore.htmlformentry.action.CleanDiagnosisConstructAction" />

    <script type="text/javascript">

        jq(function() {
            // handlers for next and submit buttons, see nextAndSubmitButtons.js
            setUpNextAndSubmitButtons();
        });

    </script>

    <ifMode mode="VIEW" include="false">
        <h2>
            <label>
                <uimessage code="AYFS Initial"/>
            </label>
        </h2>
    </ifMode>

    <subform path="configuration/pih/subforms/encounter-provider-location-date.xml">
        <span subform-parameter="encounter-location-widget">
            <encounterLocation default="SessionAttribute:emrContext.sessionLocationId"
                               tags="Maternal and Child Location"/>
        </span>
        <span subform-parameter="encounter-provider-widget">
            <encounterProviderAndRole default="currentUser"
                                      encounterRole="4f10ad1a-ec49-48df-98c7-1391c6ac7f05"
                                      providerRoles="${providerGroup.group2}"
                                      required="true"/>
        </span>
    </subform>

    <section id="gbv" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="GBV screening">
        <div class="section-container">
            <p>
                <label>
                    <i>
                        <uimessage code="Note: ‘Anyone’ may include your partner, a family member,
        friend, neighbor, a client, stranger, supervisor, colleague, police officer or other persons." />
                    </i>
                </label>
            </p>

            <p class="side-by-side">
                <label>
                    <uimessage code="Has anyone hit, kicked, punched, or otherwise hurt you in the past year?" />
                </label>
                <obs conceptId="PIH:21679" style="radio" required="true"
                     answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="yes,no"/>
            </p>

            <p class="side-by-side">
                <label>
                    <uimessage code="Has anyone insulted you, ignored you, yelled at you or made you feel ashamed or
bad about yourself in the past year?" />
                </label>
                <obs conceptId="PIH:21680" style="radio" required="true"
                     answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="yes,no"/>
            </p>

            <p class="side-by-side">
                <label>
                    <uimessage code="Has anyone forced you to have sex, or perform any sexual act or touched you
sexually in any way that you did not want in the past year?" />
                </label>
                <obs conceptId="PIH:21681" style="radio" required="true"
                     answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="yes,no"/>
            </p>

            <p class="side-by-side">
                <label>
                    <uimessage code="Has anyone made you feel afraid, unsafe or in danger in the past year?" />
                </label>
                <obs conceptId="PIH:21682" style="radio" required="true"
                     answerConceptIds="CIEL:1065,CIEL:1066" answerCodes="yes,no"/>
            </p>
        </div>
    </section>

    <section id="referral" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Referral">
        <div class="section-container">
            <div class="two-columns">
                <div>
                    <p class="side-by-side">
                        <label>
                            <uimessage code="Referred from:" />
                        </label>
                        <br/>
                        <obs id="referral-list" conceptId="PIH:21696" style="radio"
                             answerSeparator="&lt;br /&gt;" >
                            <controls>
                                <when value="CIEL:5622" thenDisplay="#other-ref-text"/>
                            </controls>
                        </obs>
                    </p>
                </div>

                <div id="other-ref-text">
                    <label>
                        <uimessage code="If other, please specify" />
                    </label>
                    <obs conceptId="PIH:6421" style="textarea"/>
                </div>
            </div>

            <div class="two-columns">
                <div>
                    <p class="side-by-side">
                        <label>
                            <uimessage code="Referred by:" />
                        </label>
                        <br/>
                        <obs id="referral-role" conceptId="PIH:Type of referral role" style="radio"
                             answerConceptIds="PIH:Teacher,CIEL:170188,CIEL:978,PIH:21702,PIH:21698"
                             answerCodes="teachers,peers,self,out of school youth,self-referral following AYFS message"
                             answerSeparator="&lt;br /&gt;" />
                    </p>
                </div>

                <div>
                    <p class="side-by-side">
                        <label>
                            <uimessage code="Self" />
                        </label>
                        <obs conceptId="PIH:21684" style="radio"
                             answerConceptIds="CIEL:1065,CIEL:1066"
                             answerCodes="in school,out of school" />
                    </p>
                </div>
            </div>
            
        </div>
    </section>

    <section id="fp-history" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="pihcore.familyPlanningHistory.title">
        <div class="section-container">
            <table>
                <tr>
                    <td>
                    </td>
                    <th>
                        <label>
                            <uimessage code="pihcore.startDate" />
                        </label>
                    </th>
                    <th>
                        <label>
                            <uimessage code="pihcore.endDate" />
                        </label>
                    </th>
                </tr>
                <repeat>
                    <template>
                        <obsgroup groupingConceptId="PIH:Family planning history construct" showIfEmpty="false">
                            <tr>
                                <td id="f{dID}-fp">
                                    <obs conceptId="CIEL:374" answerConceptId="{acID}"
                                         answerCode="{csName}" style="checkbox"
                                         toggle="{id: 'f{dID}-date', style: 'dim'}"/>
                                </td>
                                <td class="f{dID}-date">
                                    <obs conceptId="CIEL:163757" />
                                </td>
                                <td class="f{dID}-date">
                                    <obs conceptId="CIEL:163758" allowFutureDates="true" />
                                </td>
                            </tr>
                        </obsgroup>
                    </template>
                    <render acID="CIEL:104625" dID="104625" csName="Microgynon" />
                    <render acID="CIEL:159783" dID="159783" csName="Other combined oral contraceptive (COC)" />
                    <render acID="CIEL:78796"  dID="78796" csName="Microlut" />
                    <render acID="CIEL:80784"  dID="80784" csName="Other progestin-only pill (POP)" />
                    <render acID="CIEL:190"    dID="190" csName="Condoms" />
                    <render acID="CIEL:907"    dID="907" csName="Depo-provera" />
                    <render acID="PIH:21450"   dID="21450" csName="Sayana press" />
                    <render acID="PIH:21478"   dID="21478"  csName="Copper T IUD" />
                    <render acID="CIEL:165464" dID="165464" csName="Hormonal IUD" />
                    <render acID="CIEL:1873"   dID="1873" csName="Jadelle" />
                    <render acID="CIEL:76022"  dID="76022" csName="Implanon" />
                    <render acID="CIEL:162422" dID="162422" csName="Other implant" />
                    <render acID="CIEL:5277"   dID="5277" csName="pihcore.fp.rhythm" />
                </repeat>
            </table>
        </div>
    </section>

    <section id="history" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Clinical history">
        <div class="section-container">
            <obs conceptId="CIEL:160221" style="textarea" />
        </div>
    </section>

    <section id="diagnosis" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Diagnosis">
        <div class="section-container">

            <div id="data-collection">
                <encounterDiagnosesByObs selectedDiagnosesTarget="#encounter-diagnoses-target"/>
            </div>

            <div id="encounter-diagnoses-target">
            </div>
        </div>
    </section>

    <section id="rapid-tests" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Laboratory tests">
        <div class="section-container">
            <h3>
                <uimessage code="Rapid Tests" />
            </h3>
            <subform path="configuration/pih/subforms/rapid-tests-widget.xml"/>
            <br/><br/>

            <h3>
                <uimessage code="Lab Orders" />
            </h3>
            <pihLabOrder />
        </div>
    </section>

    <section id="drug-orders" sectionTag="fieldset"
             headerTag="legend" headerStyle="title" headerCode="pihcore.visitNote.orders.medications">
        <div class="section-container">
            <subform path="configuration/pih/subforms/drug-order-widget.xml"/>
        </div>
    </section>

    <section id="outcome-section" sectionTag="fieldset" headerTag="legend" headerStyle="title"
             headerCode="Outcome">
        <div class="section-container">
            <div class="two-columns">
                <div>
                    <div id="disposition">
                        <encounterDisposition id="encounter-disposition" />
                    </div>
                </div>

                <div>
                    <p>
                        <label>
                            <uimessage code="Next appointment date"/>
                        </label>
                        <obs id="apptDate" conceptId="PIH:RETURN VISIT DATE"
                             allowFutureDates="true" allowPastDates="false"
                             required="false"/>
                    </p>

                    <p class="side-by-side">
                        <label>
                            <uimessage code="Followup clinic:"/>
                        </label>
                        <br/>
                        <!-- ToDo:  radio or checkboxes?  Update answers -->
                        <obs conceptId="CIEL:1272" style="radio"
                             answerConceptIds="PIH:7831,PIH:FAMILY PLANNING SERVICES,PIH:MENTAL HEALTH SERVICES,CIEL:5622"
                             answerSeparator="&lt;br /&gt;" />
                    </p>
                </div>


            </div>
        </div>
    </section>

    <ifMode mode="VIEW" include="false">
        <div id="buttons">
            <submit submitClass="confirm right" submitCode="mirebalais.save"/>
            <button type="button" class="cancel">
                <uimessage code="emr.cancel"/>
            </button>
        </div>
    </ifMode>

</htmlform>
